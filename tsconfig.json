{
  "compilerOptions": {
    /* Basic Options */
    "target": "ES2020" /* Modern JS output */,
    "module": "CommonJS" /* Node.js module system */,
    "rootDir": "./src" /* Source files location */,
    "outDir": "./dist" /* Compiled output location */,
    "moduleResolution": "node" /* Resolve modules like Node.js */,
    "esModuleInterop": true /* Allow default imports from CommonJS */,
    "resolveJsonModule": true /* Import JSON files */,
    "allowSyntheticDefaultImports": true /* Support default imports */,
    "forceConsistentCasingInFileNames": true /* Enforce consistent file naming */,
    "strict": true /* Enable all strict type checks */,
    "jsx": "react",
    "skipLibCheck": true /* Skip type checking of declaration files */,

    /* Source Maps & Debugging */
    "sourceMap": true /* Generate source maps */,
    "inlineSources": true /* Include source in maps */,

    /* Type Checking */
    "types": ["node", "jest"] /* Include Node + Jest types */,
    "noImplicitAny": true /* Disallow implicit 'any' */,
    "strictNullChecks": true /* Null safety */,
    "strictFunctionTypes": true /* Function type safety */,
    "strictBindCallApply": true /* Safer bind/call/apply */,
    "noImplicitThis": true /* Disallow implicit 'this' */,
    "alwaysStrict": true /* Parse in strict mode */
  },
  "include": ["src"] /* Include source files */,
  "exclude": [
    "node_modules",
    "dist",
    "tests/**/*.spec.ts"
  ] /* Exclude build + test output */
}
